// Yoda port: iOS 26+ runs a presentation transition whenever a window's root controller is replaced,
// and that crashes with Unity's way of moving its one view between orientation-locked controllers.
// The window gets one permanent root (YodaRootContainer); Unity's controller for the current orientation
// becomes its child, and the container reports the child's orientation mask to UIKit.
@interface YodaRootContainer : UIViewController
{
@public
	UIViewController* content;
}
@end

@implementation YodaRootContainer
- (UIInterfaceOrientationMask)supportedInterfaceOrientations
{
	return content ? [content supportedInterfaceOrientations] : UIInterfaceOrientationMaskLandscape;
}
- (BOOL)shouldAutorotate					{ return content ? [content shouldAutorotate] : YES; }
- (BOOL)prefersStatusBarHidden				{ return YES; }
- (BOOL)prefersHomeIndicatorAutoHidden		{ return YES; }
- (UIRectEdge)preferredScreenEdgesDeferringSystemGestures { return UIRectEdgeAll; }
@end

static YodaRootContainer* _yodaRoot = nil;

.
