// The engine presents and dismisses through MediaPlayer's UIViewController category; route both to
// plain full-screen modal presentation of this controller.
static void YodaPresentMovie(UIViewController* self_, SEL _cmd, UIViewController* vc)
{
	NSLog(@"[yoda] present movie from %@", self_);
	[self_ presentViewController:vc animated:NO completion:nil];
}
static void YodaDismissMovie(UIViewController* self_, SEL _cmd)
{
	NSLog(@"[yoda] dismiss movie");
	[self_ dismissViewControllerAnimated:NO completion:nil];
}

