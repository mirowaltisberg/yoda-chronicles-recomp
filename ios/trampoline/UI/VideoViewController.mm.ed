// Yoda port: AVPlayer-based replacement for the 2015 MPMoviePlayerViewController subclass (see header).
// Manual retain/release, like the rest of the Trampoline.

@interface YodaMoviePlayerView : UIView
@end
@implementation YodaMoviePlayerView
+ (Class)layerClass { return [AVPlayerLayer class]; }
@end

@interface YodaMoviePlayer ()
{
	AVPlayer*				_player;
	YodaMoviePlayerView*	_view;
	UIView*					_backgroundView;
	BOOL					_finished;
}
- (id)initWithURL:(NSURL*)url;
- (UIView*)view;
@end

@implementation YodaMoviePlayer

- (id)initWithURL:(NSURL*)url
{
	if((self = [super init]))
	{
		_player = [[AVPlayer alloc] initWithURL:url];
		_backgroundView = [[UIView alloc] initWithFrame:CGRectZero];
		_backgroundView.backgroundColor = [UIColor blackColor];
		_view = [[YodaMoviePlayerView alloc] initWithFrame:CGRectZero];
		_view.backgroundColor = [UIColor clearColor];
		((AVPlayerLayer*)_view.layer).player = _player;
		((AVPlayerLayer*)_view.layer).videoGravity = AVLayerVideoGravityResizeAspect;
		[[NSNotificationCenter defaultCenter] addObserver:self selector:@selector(itemDidEnd:)
			name:AVPlayerItemDidPlayToEndTimeNotification object:_player.currentItem];
		[[NSNotificationCenter defaultCenter] addObserver:self selector:@selector(itemDidFail:)
			name:AVPlayerItemFailedToPlayToEndTimeNotification object:_player.currentItem];
	}
	return self;
}

- (void)dealloc
{
	[[NSNotificationCenter defaultCenter] removeObserver:self];
	[_player pause];
	[_player release];
	[_view release];
	[_backgroundView release];
	[super dealloc];
}

- (UIView*)view				{ return _view; }
- (UIView*)backgroundView	{ return _backgroundView; }

- (void)setControlStyle:(NSInteger)style	{ NSLog(@"[yoda] movie setControlStyle %ld", (long)style); }

- (void)setScalingMode:(NSInteger)mode
{
	// MPMovieScalingModeNone/AspectFit = 0/1, AspectFill = 2, Fill = 3
	NSString* gravity = mode == 2 ? AVLayerVideoGravityResizeAspectFill
					  : mode == 3 ? AVLayerVideoGravityResize : AVLayerVideoGravityResizeAspect;
	((AVPlayerLayer*)_view.layer).videoGravity = gravity;
}

- (void)play
{
	NSLog(@"[yoda] movie play (status %ld, item %ld)", (long)_player.status, (long)_player.currentItem.status);
	[_player play];
}
- (void)pause	{ NSLog(@"[yoda] movie pause"); [_player pause]; }

- (void)finishWithReason:(NSInteger)reason
{
	NSLog(@"[yoda] movie finish, reason %ld", (long)reason);
	if(_finished)
		return;
	_finished = YES;
	[_player pause];
	NSDictionary* info = @{ MPMoviePlayerPlaybackDidFinishReasonUserInfoKey: @(reason) };
	[[NSNotificationCenter defaultCenter] postNotificationName:MPMoviePlayerPlaybackDidFinishNotification
		object:self userInfo:info];
}

// MPMoviePlayerController posts "did finish" when stopped; the engine's tap-to-skip relies on it.
- (void)stop						{ [self finishWithReason:MPMovieFinishReasonUserExited]; }
- (void)itemDidEnd:(NSNotification*)n	{ [self finishWithReason:MPMovieFinishReasonPlaybackEnded]; }
- (void)itemDidFail:(NSNotification*)n
{
	NSLog(@"[yoda] movie failed: %@", n.userInfo);
	[self finishWithReason:MPMovieFinishReasonPlaybackError];
}

@end


