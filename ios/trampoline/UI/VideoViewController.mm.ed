- (BOOL)prefersStatusBarHidden				{ return YES; }
- (BOOL)prefersHomeIndicatorAutoHidden		{ return YES; }
- (UIInterfaceOrientationMask)supportedInterfaceOrientations { return UIInterfaceOrientationMaskLandscape; }

// MPMoviePlayerController autoplays (shouldAutoplay = YES); the engine never calls play itself.
- (void)viewDidAppear:(BOOL)animated
{
	[super viewDidAppear:animated];
	// developer switch for unattended testing: YODA_SKIP_MOVIES=1 ends every movie at once
	if([[NSProcessInfo processInfo].environment[@"YODA_SKIP_MOVIES"] length] > 0)
	{
		[_moviePlayer stop];
		return;
	}
	[_moviePlayer play];
}

